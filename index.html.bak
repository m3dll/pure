illic */\n@font-face {\n  font-family: 'Montserrat';\n  font-style: normal;\n  font-weight: 700;\n  font-display: swap;\n  src: url(\"0f443678-013f-4ff1-8e62-6fd116c4d831\") format('woff2');\n  unicode-range: U+0301, U+0400-045F, U+0490-0491, U+04B0-04B1, U+2116;\n}\n/* vietnamese */\n@font-face {\n  font-family: 'Montserrat';\n  font-style: normal;\n  font-weight: 700;\n  font-display: swap;\n  src: url(\"2584fda4-b991-4619-95b3-991687afa50d\") format('woff2');\n  unicode-range: U+0102-0103, U+0110-0111, U+0128-0129, U+0168-0169, U+01A0-01A1, U+01AF-01B0, U+0300-0301, U+0303-0304, U+0308-0309, U+0323, U+0329, U+1EA0-1EF9, U+20AB;\n}\n/* latin-ext */\n@font-face {\n  font-family: 'Montserrat';\n  font-style: normal;\n  font-weight: 700;\n  font-display: swap;\n  src: url(\"a2a4ef4f-50ba-4d5c-a37e-1d51b883ec26\") format('woff2');\n  unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF;\n}\n/* latin */\n@font-face {\n  font-family: 'Montserrat';\n  font-style: normal;\n  font-weight: 700;\n  font-display: swap;\n  src: url(\"471c122a-a2c8-4d05-b4f8-78f00bc38602\") format('woff2');\n  unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;\n}\n<\u002Fstyle>\n<style>\n  :root {\n    --accent: #d11f3a;\n    --accent-soft: #7c1020;\n    --bg: #08070a;\n    --ink: #ecedf0;\n    --ink-soft: #8d8d96;\n    --ink-faint: #5a5a63;\n    --line: rgba(255,255,255,0.065);\n  }\n  * { box-sizing: border-box; }\n  html { scroll-behavior: smooth; }\n  body { margin: 0; }\n  ::selection { background: rgba(209,31,58,0.32); color: #fff; }\n  @keyframes glowBreathe {\n    0%,100% { opacity: .55; transform: translateX(-50%) scale(1); }\n    50%     { opacity: .85; transform: translateX(-50%) scale(1.08); }\n  }\n  @keyframes floatUp {\n    from { opacity: 0; transform: translateY(10px); }\n    to   { opacity: 1; transform: translateY(0); }\n  }\n<\u002Fstyle>\n<\u002Fhelmet>\n\n<div style=\"position:relative;min-height:100vh;background:var(--bg);color:var(--ink);font-family:'Montserrat',system-ui,sans-serif;line-height:1.6;-webkit-font-smoothing:antialiased;overflow-x:hidden;\">\n\n  <div id=\"topGlow\" style=\"position:fixed;top:-340px;left:50%;width:1100px;height:680px;pointer-events:none;z-index:0;background:radial-gradient(closest-side, rgba(209,31,58,0.16), rgba(124,16,32,0.06) 45%, transparent 72%);animation:glowBreathe 9s ease-in-out infinite;\"><\u002Fdiv>\n\n  <div id=\"grain\" style=\"position:fixed;inset:0;pointer-events:none;z-index:60;opacity:0.035;mix-blend-mode:overlay;background-image:url('data:image/svg+xml;utf8,&lt;svg xmlns=%22http://www.w3.org/2000/svg%22 width=%22160%22 height=%22160%22&gt;&lt;filter id=%22n%22&gt;&lt;feTurbulence type=%22fractalNoise%22 baseFrequency=%220.85%22 numOctaves=%222%22 stitchTiles=%22stitch%22/&gt;&lt;/filter&gt;&lt;rect width=%22100%25%22 height=%22100%25%22 filter=%22url(%23n)%22/&gt;&lt;/svg&gt;');\"><\u002Fdiv>\n\n  <div style=\"position:fixed;top:0;left:0;right:0;height:2px;z-index:80;background:rgba(255,255,255,0.04);\">\n    <div id=\"progress\" style=\"height:100%;transform-origin:0 50%;transform:scaleX(0);background:linear-gradient(90deg,var(--accent),var(--accent-soft));box-shadow:0 0 12px rgba(209,31,58,0.6);\"><\u002Fdiv>\n  <\u002Fdiv>\n\n  <header id=\"topbar\" style=\"position:sticky;top:0;z-index:50;backdrop-filter:blur(14px) saturate(140%);-webkit-backdrop-filter:blur(14px) saturate(140%);background:rgba(8,7,10,0.62);border-bottom:1px solid rgba(255,255,255,0);transition:border-color .5s ease;\">\n    <div style=\"max-width:780px;margin:0 auto;padding:14px 24px;display:flex;align-items:center;justify-content:space-between;\">\n      <div style=\"display:flex;align-items:center;gap:11px;\">\n        <img src=\"7daaacfb-ebe5-48c0-9485-1e5cd3632915\" alt=\"\" style=\"width:24px;height:24px;border-radius:7px;\">\n        <span style=\"font:500 12px 'JetBrains Mono',monospace;letter-spacing:0.22em;color:var(--ink);\">PURE&nbsp;FR<\u002Fspan>\n      <\u002Fdiv>\n      <span style=\"font:400 11px 'JetBrains Mono',monospace;letter-spacing:0.18em;color:var(--ink-faint);\">PATCH&nbsp;NOTE&nbsp;·&nbsp;v1.1<\u002Fspan>\n    <\u002Fdiv>\n  <\u002Fheader>\n\n  <div style=\"position:relative;z-index:1;max-width:780px;margin:0 auto;padding:0 24px;\">\n\n    <header style=\"text-align:center;padding:104px 0 72px;\">\n      <img class=\"hero-logo\" src=\"7daaacfb-ebe5-48c0-9485-1e5cd3632915\" alt=\"Logo Pure FR\" style=\"width:78px;height:78px;border-radius:20px;border:1px solid rgba(255,255,255,0.09);box-shadow:0 26px 70px -24px rgba(209,31,58,0.55), 0 4px 18px rgba(0,0,0,0.6);\" data-reveal=\"\">\n      <div style=\"margin-top:30px;font:500 12px 'JetBrains Mono',monospace;letter-spacing:0.34em;text-transform:uppercase;color:var(--accent);\" data-reveal=\"\">Pure FR<\u002Fdiv>\n      <h1 style=\"margin:16px 0 0;font:600 clamp(40px,8vw,68px) 'Montserrat',sans-serif;letter-spacing:-0.035em;line-height:1.02;color:#f6f6f8;\" data-reveal=\"\">Patch Note v1.1<\u002Fh1>\n      <p style=\"max-width:480px;margin:22px auto 0;color:var(--ink-soft);font-size:16.5px;font-weight:400;\" data-reveal=\"\">Métiers, vie de joueur et activités du serveur — tout ce qui vous attend en ville.<\u002Fp>\n      <div style=\"width:54px;height:2px;margin:40px auto 0;border-radius:2px;background:linear-gradient(90deg,var(--accent),transparent);\" data-reveal=\"\"><\u002Fdiv>\n    <\u002Fheader>\n\n    <main style=\"padding-bottom:64px;\">\n\n      <section style=\"padding-top:48px;\">\n        <div data-reveal=\"\" style=\"display:flex;align-items:baseline;gap:16px;padding-bottom:18px;margin-bottom:30px;border-bottom:1px solid var(--line);\">\n          <span style=\"font:500 12px 'JetBrains Mono',monospace;letter-spacing:0.16em;color:var(--ink-faint);\">01<\u002Fspan>\n          <h2 style=\"margin:0;font:600 clamp(26px,4.5vw,34px) 'Montserrat',sans-serif;letter-spacing:-0.025em;color:#f3f3f5;display:flex;align-items:center;gap:13px;\"><span style=\"font-size:0.78em;opacity:0.85;filter:saturate(0.85);\">⚖️<\u002Fspan>Légal<\u002Fh2>\n        <\u002Fdiv>\n\n        <div data-reveal=\"\" style=\"margin:6px 0 18px;display:flex;align-items:center;gap:10px;font:500 12px 'JetBrains Mono',monospace;letter-spacing:0.18em;text-transform:uppercase;color:var(--ink-soft);\"><span style=\"width:5px;height:5px;border-radius:50%;background:var(--accent);\"><\u002Fspan><span style=\"opacity:0.8;filter:saturate(0.85);\">💼<\u002Fspan> Métiers<\u002Fdiv>\n\n        <div style=\"display:flex;flex-direction:column;gap:12px;\">\n          <div data-reveal=\"\" data-card=\"\" style=\"background:rgba(255,255,255,0.018);border:1px solid var(--line);border-radius:15px;padding:22px 24px;transition:transform .45s cubic-bezier(.22,1,.36,1),border-color .45s ease,background .45s ease,box-shadow .45s ease;\" style-hover=\"transform:translateY(-3px);border-color:rgba(209,31,58,0.42);background:rgba(255,255,255,0.032);box-shadow:0 16px 50px -18px rgba(192,20,46,0.3),inset 2px 0 0 var(--accent);\">\n            <h3 style=\"margin:0 0 9px;font:600 16px 'Montserrat';color:var(--ink);display:flex;align-items:center;gap:11px;\"><span style=\"font-size:17px;opacity:0.85;\">👮<\u002Fspan>Police (LSPD)<\u002Fh3>\n            <p style=\"margin:0;color:var(--ink-soft);font:400 14.5px/1.65 'Montserrat';\">Patrouille, arrestations et menottage, fouilles et saisies de preuves. Accès au MDT (fiches, recherches, casiers), au dispatch en temps réel, aux gyrophares personnalisables et au radar Wraith ARS 2X (lecture de plaques, alerte 10-38 automatique). Casiers personnels verrouillés par code PIN au commissariat.<\u002Fp>\n          <\u002Fdiv>\n\n          <div data-reveal=\"\" data-card=\"\" style=\"background:rgba(255,255,255,0.018);border:1px solid var(--line);border-radius:15px;padding:22px 24px;transition:transform .45s cubic-bezier(.22,1,.36,1),border-color .45s ease,background .45s ease,box-shadow .45s ease;\" style-hover=\"transform:translateY(-3px);border-color:rgba(209,31,58,0.42);background:rgba(255,255,255,0.032);box-shadow:0 16px 50px -18px rgba(192,20,46,0.3),inset 2px 0 0 var(--accent);\">\n            <h3 style=\"margin:0 0 9px;font:600 16px 'Montserrat';color:var(--ink);display:flex;align-items:center;gap:11px;\"><span style=\"font-size:17px;opacity:0.85;\">🚑<\u002Fspan>Ambulancier / EMS<\u002Fh3>\n            <p style=\"margin:0;color:var(--ink-soft);font:400 14.5px/1.65 'Montserrat';\">Système de blessures, de réanimation et de soin automatique. Prise en charge des morts/inconscients et facturation des soins.<\u002Fp>\n            <span style=\"display:inline-block;margin-top:13px;font:500 11px 'JetBrains Mono',monospace;letter-spacing:0.1em;text-transform:uppercase;color:var(--ink-faint);border:1px solid var(--line);border-radius:999px;padding:4px 11px;\">Pas encore jouable<\u002Fspan>\n          <\u002Fdiv>\n\n          <div data-reveal=\"\" data-card=\"\" style=\"background:rgba(255,255,255,0.018);border:1px solid var(--line);border-radius:15px;padding:22px 24px;transition:transform .45s cubic-bezier(.22,1,.36,1),border-color .45s ease,background .45s ease,box-shadow .45s ease;\" style-hover=\"transform:translateY(-3px);border-color:rgba(209,31,58,0.42);background:rgba(255,255,255,0.032);box-shadow:0 16px 50px -18px rgba(192,20,46,0.3),inset 2px 0 0 var(--accent);\">\n            <h3 style=\"margin:0 0 9px;font:600 16px 'Montserrat';color:var(--ink);display:flex;align-items:center;gap:11px;\"><span style=\"font-size:17px;opacity:0.85;\">🔧<\u002Fspan>Mécanicien<\u002Fh3>\n            <p style=\"margin:0;color:var(--ink-soft);font:400 14.5px/1.65 'Montserrat';\">Réparation et customisation des véhicules. Achat de marchandises en gros (kits de réparation, etc.) via un shop grossiste réservé au métier.<\u002Fp>\n          <\u002Fdiv>\n\n          <div data-reveal=\"\" data-card=\"\" style=\"background:rgba(255,255,255,0.018);border:1px solid var(--line);border-radius:15px;padding:22px 24px;transition:transform .45s cubic-bezier(.22,1,.36,1),border-color .45s ease,background .45s ease,box-shadow .45s ease;\" style-hover=\"transform:translateY(-3px);border-color:rgba(209,31,58,0.42);background:rgba(255,255,255,0.032);box-shadow:0 16px 50px -18px rgba(192,20,46,0.3),inset 2px 0 0 var(--accent);\">\n            <h3 style=\"margin:0 0 9px;font:600 16px 'Montserrat';color:var(--ink);display:flex;align-items:center;gap:11px;\"><span style=\"font-size:17px;opacity:0.85;\">🚗<\u002Fspan>Premium Deluxe Motorsport (PDM)<\u002Fh3>\n            <p style=\"margin:0;color:var(--ink-soft);font:400 14.5px/1.65 'Montserrat';\">Vente de véhicules via un catalogue NUI moderne (filtres prix/marque/catégorie, images, fiches détaillées, nombre de places et coffre affichés, prévisualisation et test drive). Les employés PDM peuvent faire des doubles de clés et ré-éditer une carte grise chez le serrurier.<\u002Fp>\n          <\u002Fdiv>\n\n          <div data-reveal=\"\" data-card=\"\" style=\"background:rgba(255,255,255,0.018);border:1px solid var(--line);border-radius:15px;padding:22px 24px;transition:transform .45s cubic-bezier(.22,1,.36,1),border-color .45s ease,background .45s ease,box-shadow .45s ease;\" style-hover=\"transform:translateY(-3px);border-color:rgba(209,31,58,0.42);background:rgba(255,255,255,0.032);box-shadow:0 16px 50px -18px rgba(192,20,46,0.3),inset 2px 0 0 var(--accent);\">\n            <h3 style=\"margin:0 0 9px;font:600 16px 'Montserrat';color:var(--ink);display:flex;align-items:center;gap:11px;\"><span style=\"font-size:17px;opacity:0.85;\">🏠<\u002Fspan>Agent immobilier<\u002Fh3>\n            <p style=\"margin:0;color:var(--ink-soft);font:400 14.5px/1.65 'Montserrat';\">Vente de maisons et gestion des propriétés. Pose de coffres à code PIN pour les habitants.<\u002Fp>\n          <\u002Fdiv>\n\n          <div data-reveal=\"\" data-card=\"\" style=\"background:rgba(255,255,255,0.018);border:1px solid var(--line);border-radius:15px;padding:22px 24px;transition:transform .45s cubic-bezier(.22,1,.36,1),border-color .45s ease,background .45s ease,box-shadow .45s ease;\" style-hover=\"transform:translateY(-3px);border-color:rgba(209,31,58,0.42);background:rgba(255,255,255,0.032);box-shadow:0 16px 50px -18px rgba(192,20,46,0.3),inset 2px 0 0 var(--accent);\">\n            <h3 style=\"margin:0 0 9px;font:600 16px 'Montserrat';color:var(--ink);display:flex;align-items:center;gap:11px;\"><span style=\"font-size:17px;opacity:0.85;\">🏪<\u002Fspan>LTD / Épicerie (Strawberry)<\u002Fh3>\n            <p style=\"margin:0;color:var(--ink-soft);font:400 14.5px/1.65 'Montserrat';\">Réapprovisionnement en gros du shop pour la revente.<\u002Fp>\n          <\u002Fdiv>\n\n          <div data-reveal=\"\" data-card=\"\" style=\"background:rgba(255,255,255,0.018);border:1px solid var(--line);border-radius:15px;padding:22px 24px;transition:transform .45s cubic-bezier(.22,1,.36,1),border-color .45s ease,background .45s ease,box-shadow .45s ease;\" style-hover=\"transform:translateY(-3px);border-color:rgba(209,31,58,0.42);background:rgba(255,255,255,0.032);box-shadow:0 16px 50px -18px rgba(192,20,46,0.3),inset 2px 0 0 var(--accent);\">\n            <h3 style=\"margin:0 0 9px;font:600 16px 'Montserrat';color:var(--ink);display:flex;align-items:center;gap:11px;\"><span style=\"font-size:17px;opacity:0.85;\">🚌<\u002Fspan>Chauffeur de bus<\u002Fh3>\n            <p style=\"margin:0;color:var(--ink-soft);font:400 14.5px/1.65 'Montserrat';\">Tournées de ramassage de PNJ autour de la map contre rémunération. Job en intérim (voir règlement).<\u002Fp>\n          <\u002Fdiv>\n\n          <div data-reveal=\"\" data-card=\"\" style=\"background:rgba(255,255,255,0.018);border:1px solid var(--line);border-radius:15px;padding:22px 24px;transition:transform .45s cubic-bezier(.22,1,.36,1),border-color .45s ease,background .45s ease,box-shadow .45s ease;\" style-hover=\"transform:translateY(-3px);border-color:rgba(209,31,58,0.42);background:rgba(255,255,255,0.032);box-shadow:0 16px 50px -18px rgba(192,20,46,0.3),inset 2px 0 0 var(--accent);\">\n            <h3 style=\"margin:0 0 9px;font:600 16px 'Montserrat';color:var(--ink);display:flex;align-items:center;gap:11px;\"><span style=\"font-size:17px;opacity:0.85;\">🎤<\u002Fspan>Animateur<\u002Fh3>\n            <p style=\"margin:0;color:var(--ink-soft);font:400 14.5px/1.65 'Montserrat';\">Menu dédié (F9) pour les events : soigner, réanimer et distribuer des items.<\u002Fp>\n          <\u002Fdiv>\n\n          <div data-reveal=\"\" data-card=\"\" style=\"background:rgba(255,255,255,0.018);border:1px solid var(--line);border-radius:15px;padding:22px 24px;transition:transform .45s cubic-bezier(.22,1,.36,1),border-color .45s ease,background .45s ease,box-shadow .45s ease;\" style-hover=\"transform:translateY(-3px);border-color:rgba(209,31,58,0.42);background:rgba(255,255,255,0.032);box-shadow:0 16px 50px -18px rgba(192,20,46,0.3),inset 2px 0 0 var(--accent);\">\n            <h3 style=\"margin:0 0 9px;font:600 16px 'Montserrat';color:var(--ink);display:flex;align-items:center;gap:11px;\"><span style=\"font-size:17px;opacity:0.85;\">💵<\u002Fspan>Patrons d’entreprise<\u002Fh3>\n            <p style=\"margin:0;color:var(--ink-soft);font:400 14.5px/1.65 'Montserrat';\">Gestion des employés (embauche / renvoi), compte société en banque, facturation entre joueurs et paye automatique configurable depuis le téléphone (LB Phone · Services) : activation toutes les 15 min et montant réglable par grade.<\u002Fp>\n          <\u002Fdiv>\n        <\u002Fdiv>\n      <\u002Fsection>\n\n      <section style=\"padding-top:72px;\">\n        <div data-reveal=\"\" style=\"display:flex;align-items:baseline;gap:16px;padding-bottom:18px;margin-bottom:30px;border-bottom:1px solid var(--line);\">\n          <span style=\"font:500 12px 'JetBrains Mono',monospace;letter-spacing:0.16em;color:var(--ink-faint);\">02<\u002Fspan>\n          <h2 style=\"margin:0;font:600 clamp(26px,4.5vw,34px) 'Montserrat',sans-serif;letter-spacing:-0.025em;color:#f3f3f5;display:flex;align-items:center;gap:13px;\"><span style=\"font-size:0.78em;opacity:0.85;\">🧍<\u002Fspan>Vie de joueur<\u002Fh2>\n        <\u002Fdiv>\n\n        <div data-reveal=\"\" style=\"margin:6px 0 14px;display:flex;align-items:center;gap:10px;font:500 12px 'JetBrains Mono',monospace;letter-spacing:0.18em;text-transform:uppercase;color:var(--ink-soft);\"><span style=\"width:5px;height:5px;border-radius:50%;background:var(--accent);\"><\u002Fspan><span style=\"opacity:0.8;\">📱<\u002Fspan> Quotidien et gestion<\u002Fdiv>\n        <div data-reveal=\"\" data-card=\"\" style=\"border:1px solid var(--line);border-radius:15px;background:rgba(255,255,255,0.012);overflow:hidden;transition:border-color .45s ease;\" style-hover=\"border-color:rgba(255,255,255,0.12);\">\n          <div style=\"padding:15px 22px;border-bottom:1px solid var(--line);display:grid;grid-template-columns:auto 1fr;gap:13px;align-items:start;\"><span style=\"width:5px;height:5px;border-radius:50%;background:var(--accent);margin-top:9px;opacity:0.7;\"><\u002Fspan><p style=\"margin:0;color:var(--ink-soft);font:400 14.5px/1.6 'Montserrat';\"><b style=\"color:var(--ink);font-weight:600;\">📱 Téléphone (LB Phone)<\u002Fb> — Téléphone complet avec apps, contacts, messages et carte (Maps) affichant les commerces.<\u002Fp><\u002Fdiv>\n          <div style=\"padding:15px 22px;border-bottom:1px solid var(--line);display:grid;grid-template-columns:auto 1fr;gap:13px;align-items:start;\"><span style=\"width:5px;height:5px;border-radius:50%;background:var(--accent);margin-top:9px;opacity:0.7;\"><\u002Fspan><p style=\"margin:0;color:var(--ink-soft);font:400 14.5px/1.6 'Montserrat';\"><b style=\"color:var(--ink);font-weight:600;\">🏦 Banque<\u002Fb> — Comptes bancaires, dépôts/retraits, DAB en ville, possibilité de bloquer l’accès bancaire depuis un téléphone volé, etc.<\u002Fp><\u002Fdiv>\n          <div style=\"padding:15px 22px;border-bottom:1px solid var(--line);display:grid;grid-template-columns:auto 1fr;gap:13px;align-items:start;\"><span style=\"width:5px;height:5px;border-radius:50%;background:var(--accent);margin-top:9px;opacity:0.7;\"><\u002Fspan><p style=\"margin:0;color:var(--ink-soft);font:400 14.5px/1.6 'Montserrat';\"><b style=\"color:var(--ink);font-weight:600;\">🧑‍🤝‍🧑 Multi-personnages<\u002Fb> — Créez et gérez plusieurs personnages.<\u002Fp><\u002Fdiv>\n          <div style=\"padding:15px 22px;display:grid;grid-template-columns:auto 1fr;gap:13px;align-items:start;\"><span style=\"width:5px;height:5px;border-radius:50%;background:var(--accent);margin-top:9px;opacity:0.7;\"><\u002Fspan><p style=\"margin:0;color:var(--ink-soft);font:400 14.5px/1.6 'Montserrat';\"><b style=\"color:var(--ink);font-weight:600;\">👕 Apparence &amp; vêtements<\u002Fb> — Personnalisation complète du perso, penderie, aperçu 3D et gestion des tenues.<\u002Fp><\u002Fdiv>\n        <\u002Fdiv>\n\n        <div data-reveal=\"\" style=\"margin:28px 0 14px;display:flex;align-items:center;gap:10px;font:500 12px 'JetBrains Mono',monospace;letter-spacing:0.18em;text-transform:uppercase;color:var(--ink-soft);\"><span style=\"width:5px;height:5px;border-radius:50%;background:var(--accent);\"><\u002Fspan><span style=\"opacity:0.8;\">🚙<\u002Fspan> Véhicules et logement<\u002Fdiv>\n        <div data-reveal=\"\" data-card=\"\" style=\"border:1px solid var(--line);border-radius:15px;background:rgba(255,255,255,0.012);overflow:hidden;transition:border-color .45s ease;\" style-hover=\"border-color:rgba(255,255,255,0.12);\">\n          <div style=\"padding:15px 22px;border-bottom:1px solid var(--line);display:grid;grid-template-columns:auto 1fr;gap:13px;align-items:start;\"><span style=\"width:5px;height:5px;border-radius:50%;background:var(--accent);margin-top:9px;opacity:0.7;\"><\u002Fspan><p style=\"margin:0;color:var(--ink-soft);font:400 14.5px/1.6 'Montserrat';\"><b style=\"color:var(--ink);font-weight:600;\">🚙 Garages &amp; véhicules<\u002Fb> — Garages modernes et véhicules personnels persistants : votre voiture reste là où vous la garez, même après déconnexion (plus de mise en fourrière automatique au logout). Clés de véhicule, clignotants et warning, appel de phares, changement de siège au pavé numérique, bâche de véhicule.<\u002Fp><\u002Fdiv>\n          <div style=\"padding:15px 22px;display:grid;grid-template-columns:auto 1fr;gap:13px;align-items:start;\"><span style=\"width:5px;height:5px;border-radius:50%;background:var(--accent);margin-top:9px;opacity:0.7;\"><\u002Fspan><p style=\"margin:0;color:var(--ink-soft);font:400 14.5px/1.6 'Montserrat';\"><b style=\"color:var(--ink);font-weight:600;\">🏡 Logement &amp; déco<\u002Fb> — Achat/aménagement de maisons avec meubles, posters et graffitis décoratifs, coffres PIN.<\u002Fp><\u002Fdiv>\n        <\u002Fdiv>\n\n        <div data-reveal=\"\" style=\"margin:28px 0 14px;display:flex;align-items:center;gap:10px;font:500 12px 'JetBrains Mono',monospace;letter-spacing:0.18em;text-transform:uppercase;color:var(--ink-soft);\"><span style=\"width:5px;height:5px;border-radius:50%;background:var(--accent);\"><\u002Fspan><span style=\"opacity:0.8;\">🍔<\u002Fspan> Confort et immersion<\u002Fdiv>\n        <div data-reveal=\"\" data-card=\"\" style=\"border:1px solid var(--line);border-radius:15px;background:rgba(255,255,255,0.012);overflow:hidden;transition:border-color .45s ease;\" style-hover=\"border-color:rgba(255,255,255,0.12);\">\n          <div style=\"padding:15px 22px;border-bottom:1px solid var(--line);display:grid;grid-template-columns:auto 1fr;gap:13px;align-items:start;\"><span style=\"width:5px;height:5px;border-radius:50%;background:var(--accent);margin-top:9px;opacity:0.7;\"><\u002Fspan><p style=\"margin:0;color:var(--ink-soft);font:400 14.5px/1.6 'Montserrat';\"><b style=\"color:var(--ink);font-weight:600;\">🍔 Survie &amp; HUD<\u002Fb> — Barres de faim/soif style GTA, radar étendu.<\u002Fp><\u002Fdiv>\n          <div style=\"padding:15px 22px;border-bottom:1px solid var(--line);display:grid;grid-template-columns:auto 1fr;gap:13px;align-items:start;\"><span style=\"width:5px;height:5px;border-radius:50%;background:var(--accent);margin-top:9px;opacity:0.7;\"><\u002Fspan><p style=\"margin:0;color:var(--ink-soft);font:400 14.5px/1.6 'Montserrat';\"><b style=\"color:var(--ink);font-weight:600;\">😴 Confort<\u002Fb> — Votre perso reste en ville après votre déconnexion (il sauvegarde même la dernière emote !), mode photo libre, GPS tracker, écrans TV plaçables, renommage d’items.<\u002Fp><\u002Fdiv>\n          <div style=\"padding:15px 22px;border-bottom:1px solid var(--line);display:grid;grid-template-columns:auto 1fr;gap:13px;align-items:start;\"><span style=\"width:5px;height:5px;border-radius:50%;background:var(--accent);margin-top:9px;opacity:0.7;\"><\u002Fspan><p style=\"margin:0;color:var(--ink-soft);font:400 14.5px/1.6 'Montserrat';\"><b style=\"color:var(--ink);font-weight:600;\">🖐 Détails immersifs<\u002Fb> — Choix de la main directrice (droitier/gaucher) à la création, swap d’épaule à la visée, recul d’arme réaliste, arme visible dans le dos, minimap affichée uniquement en véhicule ou avec un téléphone, commande /wam pour dégainer ses armes de manière différente.<\u002Fp><\u002Fdiv>\n          <div style=\"padding:15px 22px;display:grid;grid-template-columns:auto 1fr;gap:13px;align-items:start;\"><span style=\"width:5px;height:5px;border-radius:50%;background:var(--accent);margin-top:9px;opacity:0.7;\"><\u002Fspan><p style=\"margin:0;color:var(--ink-soft);font:400 14.5px/1.6 'Montserrat';\"><b style=\"color:var(--ink);font-weight:600;\">🪙 Fun<\u002Fb> — Pile ou face visible par tous, scoreboard, météo et heure synchronisées.<\u002Fp><\u002Fdiv>\n        <\u002Fdiv>\n      <\u002Fsection>\n\n      <section style=\"padding-top:72px;\">\n        <div data-reveal=\"\" style=\"display:flex;align-items:baseline;gap:16px;padding-bottom:18px;margin-bottom:30px;border-bottom:1px solid rgba(209,31,58,0.3);\">\n          <span style=\"font:500 12px 'JetBrains Mono',monospace;letter-spacing:0.16em;color:var(--accent);\">03<\u002Fspan>\n          <h2 style=\"margin:0;font:600 clamp(26px,4.5vw,34px) 'Montserrat',sans-serif;letter-spacing:-0.025em;color:#f3f3f5;display:flex;align-items:center;gap:13px;\"><span style=\"font-size:0.78em;opacity:0.9;\">🚨<\u002Fspan>Illégal<\u002Fh2>\n        <\u002Fdiv>\n\n        <div data-reveal=\"\" style=\"margin:6px 0 14px;display:flex;align-items:center;gap:10px;font:500 12px 'JetBrains Mono',monospace;letter-spacing:0.18em;text-transform:uppercase;color:var(--ink-soft);\"><span style=\"width:5px;height:5px;border-radius:50%;background:var(--accent);\"><\u002Fspan><span style=\"opacity:0.8;\">💰<\u002Fspan> Braquages et vols<\u002Fdiv>\n        <div data-reveal=\"\" data-card=\"\" style=\"border:1px solid var(--line);border-radius:15px;background:rgba(209,31,58,0.025);overflow:hidden;transition:border-color .45s ease;\" style-hover=\"border-color:rgba(209,31,58,0.3);\">\n          <div style=\"padding:15px 22px;border-bottom:1px solid var(--line);display:grid;grid-template-columns:auto 1fr;gap:13px;align-items:start;\"><span style=\"width:5px;height:5px;border-radius:50%;background:var(--accent);margin-top:9px;\"><\u002Fspan><p style=\"margin:0;color:var(--ink-soft);font:400 14.5px/1.6 'Montserrat';\"><b style=\"color:var(--ink);font-weight:600;\">🏦 Braquage de banque<\u002Fb> — Casse des banques et sabotage des centrales électriques.<\u002Fp><\u002Fdiv>\n          <div style=\"padding:15px 22px;border-bottom:1px solid var(--line);display:grid;grid-template-columns:auto 1fr;gap:13px;align-items:start;\"><span style=\"width:5px;height:5px;border-radius:50%;background:var(--accent);margin-top:9px;\"><\u002Fspan><p style=\"margin:0;color:var(--ink-soft);font:400 14.5px/1.6 'Montserrat';\"><b style=\"color:var(--ink);font-weight:600;\">💎 Bijouterie<\u002Fb> — Braquage des bijouteries pour un butin à revendre.<\u002Fp><\u002Fdiv>\n          <div style=\"padding:15px 22px;border-bottom:1px solid var(--line);display:grid;grid-template-columns:auto 1fr;gap:13px;align-items:start;\"><span style=\"width:5px;height:5px;border-radius:50%;background:var(--accent);margin-top:9px;\"><\u002Fspan><p style=\"margin:0;color:var(--ink-soft);font:400 14.5px/1.6 'Montserrat';\"><b style=\"color:var(--ink);font-weight:600;\">🏪 Magasins<\u002Fb> — Braquage de certains LTD de la map (argent et items).<\u002Fp><\u002Fdiv>\n          <div style=\"padding:15px 22px;border-bottom:1px solid var(--line);display:grid;grid-template-columns:auto 1fr;gap:13px;align-items:start;\"><span style=\"width:5px;height:5px;border-radius:50%;background:var(--accent);margin-top:9px;\"><\u002Fspan><p style=\"margin:0;color:var(--ink-soft);font:400 14.5px/1.6 'Montserrat';\"><b style=\"color:var(--ink);font-weight:600;\">🚚 G6<\u002Fb> — Braquage de G6 pour cash et marchandises.<\u002Fp><\u002Fdiv>\n          <div style=\"padding:15px 22px;border-bottom:1px solid var(--line);display:grid;grid-template-columns:auto 1fr;gap:13px;align-items:start;\"><span style=\"width:5px;height:5px;border-radius:50%;background:var(--accent);margin-top:9px;\"><\u002Fspan><p style=\"margin:0;color:var(--ink-soft);font:400 14.5px/1.6 'Montserrat';\"><b style=\"color:var(--ink);font-weight:600;\">🏚 Cambriolage de maisons<\u002Fb> — Pillage de propriétés pour des objets à écouler.<\u002Fp><\u002Fdiv>\n          <div style=\"padding:15px 22px;border-bottom:1px solid var(--line);display:grid;grid-template-columns:auto 1fr;gap:13px;align-items:start;\"><span style=\"width:5px;height:5px;border-radius:50%;background:var(--accent);margin-top:9px;\"><\u002Fspan><p style=\"margin:0;color:var(--ink-soft);font:400 14.5px/1.6 'Montserrat';\"><b style=\"color:var(--ink);font-weight:600;\">🏧 Vol de DAB<\u002Fb> — Forcez les distributeurs automatiques de billets.<\u002Fp><\u002Fdiv>\n          <div style=\"padding:15px 22px;display:grid;grid-template-columns:auto 1fr;gap:13px;align-items:start;\"><span style=\"width:5px;height:5px;border-radius:50%;background:var(--accent);margin-top:9px;\"><\u002Fspan><p style=\"margin:0;color:var(--ink-soft);font:400 14.5px/1.6 'Montserrat';\"><b style=\"color:var(--ink);font-weight:600;\">🚗 Vol de véhicules<\u002Fb> — Crochetage (lockpick), carjacking à main armée et vol de clés sur le conducteur. Les véhicules volés deviennent persistants (jusqu’au reboot).<\u002Fp><\u002Fdiv>\n        <\u002Fdiv>\n\n        <div data-reveal=\"\" style=\"margin:28px 0 14px;display:flex;align-items:center;gap:10px;font:500 12px 'JetBrains Mono',monospace;letter-spacing:0.18em;text-transform:uppercase;color:var(--ink-soft);\"><span style=\"width:5px;height:5px;border-radius:50%;background:var(--accent);\"><\u002Fspan><span style=\"opacity:0.8;\">🔫<\u002Fspan> Trafics et criminalité<\u002Fdiv>\n        <div data-reveal=\"\" data-card=\"\" style=\"border:1px solid var(--line);border-radius:15px;background:rgba(209,31,58,0.025);overflow:hidden;transition:border-color .45s ease;\" style-hover=\"border-color:rgba(209,31,58,0.3);\">\n          <div style=\"padding:15px 22px;border-bottom:1px solid var(--line);display:grid;grid-template-columns:auto 1fr;gap:13px;align-items:start;\"><span style=\"width:5px;height:5px;border-radius:50%;background:var(--accent);margin-top:9px;\"><\u002Fspan><p style=\"margin:0;color:var(--ink-soft);font:400 14.5px/1.6 'Montserrat';\"><b style=\"color:var(--ink);font-weight:600;\">💊 Drogues<\u002Fb> — à découvrir en jeu.<\u002Fp><\u002Fdiv>\n          <div style=\"padding:15px 22px;border-bottom:1px solid var(--line);display:grid;grid-template-columns:auto 1fr;gap:13px;align-items:start;\"><span style=\"width:5px;height:5px;border-radius:50%;background:var(--accent);margin-top:9px;\"><\u002Fspan><p style=\"margin:0;color:var(--ink-soft);font:400 14.5px/1.6 'Montserrat';\"><b style=\"color:var(--ink);font-weight:600;\">🔫 Marché noir &amp; armes<\u002Fb> — Vendeurs d’armes et accessoires planqués, stashs protégés par code PIN, drive-by pour les passagers.<\u002Fp><\u002Fdiv>\n          <div style=\"padding:15px 22px;border-bottom:1px solid var(--line);display:grid;grid-template-columns:auto 1fr;gap:13px;align-items:start;\"><span style=\"width:5px;height:5px;border-radius:50%;background:var(--accent);margin-top:9px;\"><\u002Fspan><p style=\"margin:0;color:var(--ink-soft);font:400 14.5px/1.6 'Montserrat';\"><b style=\"color:var(--ink);font-weight:600;\">🎭 Discrétion<\u002Fb> — Cagoule utilisable sur un autre joueur pour l’empêcher de voir (la carte est également désactivée s’il n’a pas de téléphone dans l’inventaire, pour plus d’immersion), possibilité de se cacher dans le coffre d’un véhicule, et nouvel objet caméra espion pour surveiller.<\u002Fp><\u002Fdiv>\n          <div style=\"padding:15px 22px;border-bottom:1px solid var(--line);display:grid;grid-template-columns:auto 1fr;gap:13px;align-items:start;\"><span style=\"width:5px;height:5px;border-radius:50%;background:var(--accent);margin-top:9px;\"><\u002Fspan><p style=\"margin:0;color:var(--ink-soft);font:400 14.5px/1.6 'Montserrat';\"><b style=\"color:var(--ink);font-weight:600;\">🔓 Crochetage<\u002Fb> — à découvrir en jeu.<\u002Fp><\u002Fdiv>\n          <div style=\"padding:15px 22px;border-bottom:1px solid var(--line);display:grid;grid-template-columns:auto 1fr;gap:13px;align-items:start;\"><span style=\"width:5px;height:5px;border-radius:50%;background:var(--accent);margin-top:9px;\"><\u002Fspan><p style=\"margin:0;color:var(--ink-soft);font:400 14.5px/1.6 'Montserrat';\"><b style=\"color:var(--ink);font-weight:600;\">💋 Prostitution<\u002Fb> — à découvrir en jeu.<\u002Fp><\u002Fdiv>\n          <div style=\"padding:15px 22px;display:grid;grid-template-columns:auto 1fr;gap:13px;align-items:start;\"><span style=\"width:5px;height:5px;border-radius:50%;background:var(--accent);margin-top:9px;\"><\u002Fspan><p style=\"margin:0;color:var(--ink-soft);font:400 14.5px/1.6 'Montserrat';\"><b style=\"color:var(--ink);font-weight:600;\">🔥 Feu réaliste<\u002Fb> — Les incendies (molotov) sont dynamiques : le feu se propage, peut démarrer aléatoirement et doit être éteint par la police (extincteur).<\u002Fp><\u002Fdiv>\n        <\u002Fdiv>\n      <\u002Fsection>\n\n    <\u002Fmain>\n  <\u002Fdiv>\n\n  <footer data-reveal=\"\" style=\"position:relative;z-index:1;text-align:center;padding:56px 24px 90px;border-top:1px solid var(--line);\">\n    <div style=\"font:300 19px 'Montserrat';font-style:italic;color:var(--ink-soft);margin-bottom:12px;\">Bon jeu, et rendez-vous en ville ! 🌆<\u002Fdiv>\n    <div style=\"font:500 12px 'JetBrains Mono',monospace;letter-spacing:0.28em;text-transform:uppercase;color:var(--ink-faint);\">Pure FR<\u002Fdiv>\n  <\u002Ffooter>\n\n<\u002Fdiv>\n<\u002Fx-dc>\n<script type=\"text/x-dc\" data-dc-script=\"\" data-props=\"{&quot;$preview&quot;:{&quot;width&quot;:820,&quot;height&quot;:1100},&quot;accent&quot;:{&quot;editor&quot;:&quot;color&quot;,&quot;default&quot;:&quot;#b01228&quot;,&quot;tsType&quot;:&quot;string&quot;,&quot;section&quot;:&quot;Style&quot;,&quot;options&quot;:[&quot;#d11f3a&quot;,&quot;#b01228&quot;,&quot;#9a1b3c&quot;,&quot;#c2603a&quot;]},&quot;grain&quot;:{&quot;editor&quot;:&quot;boolean&quot;,&quot;default&quot;:true,&quot;tsType&quot;:&quot;boolean&quot;,&quot;section&quot;:&quot;Style&quot;},&quot;animate&quot;:{&quot;editor&quot;:&quot;boolean&quot;,&quot;default&quot;:true,&quot;tsType&quot;:&quot;boolean&quot;,&quot;section&quot;:&quot;Motion&quot;}}\">\nclass Component extends DCLogic {\n  componentDidMount() {\n    const root = document.documentElement;\n    this.applyProps();\n\n    // scroll progress + sticky topbar border\n    this._onScroll = () => {\n      const max = root.scrollHeight - root.clientHeight;\n      const p = max > 0 ? Math.min(1, Math.max(0, root.scrollTop / max)) : 0;\n      const bar = document.getElementById('progress');\n      if (bar) bar.style.transform = 'scaleX(' + p + ')';\n      const hdr = document.getElementById('topbar');\n      if (hdr) hdr.style.borderBottomColor = root.scrollTop > 6 ? 'rgba(255,255,255,0.08)' : 'rgba(255,255,255,0)';\n    };\n    window.addEventListener('scroll', this._onScroll, { passive: true });\n    this._onScroll();\n\n    this.setupReveal();\n  }\n\n  componentDidUpdate() { this.applyProps(); this.setupReveal(); }\n\n  applyProps() {\n    const accent = this.props.accent || '#d11f3a';\n    document.documentElement.style.setProperty('--accent', accent);\n    const grain = document.getElementById('grain');\n    if (grain) grain.style.display = (this.props.grain === false) ? 'none' : 'block';\n  }\n\n  setupReveal() {\n    const reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;\n    const animate = this.props.animate !== false && !reduce;\n    const els = Array.from(document.querySelectorAll('[data-reveal]'));\n    if (!animate || !('IntersectionObserver' in window)) {\n      els.forEach(el => { el.style.opacity = '1'; el.style.transform = 'none'; });\n      return;\n    }\n    if (this._io) this._io.disconnect();\n    els.forEach(el => {\n      if (el.__revealDone) return;\n      el.style.opacity = '0';\n      el.style.transform = 'translateY(20px)';\n      el.style.transition = 'opacity .8s cubic-bezier(.22,1,.36,1), transform .8s cubic-bezier(.22,1,.36,1)';\n      el.style.willChange = 'opacity, transform';\n      const sibs = el.parentElement ? Array.from(el.parentElement.querySelectorAll(':scope > [data-reveal]')) : [el];\n      el.__delay = Math.min(sibs.indexOf(el), 6) * 65;\n    });\n    this._io = new IntersectionObserver((entries) => {\n      entries.forEach(e => {\n        if (e.isIntersecting) {\n          const el = e.target;\n          el.style.transitionDelay = (el.__delay || 0) + 'ms';\n          el.style.opacity = '1';\n          el.style.transform = 'none';\n          el.__revealDone = true;\n          this._io.unobserve(el);\n        }\n      });\n    }, { threshold: 0.1, rootMargin: '0px 0px -7% 0px' });\n    els.forEach(el => { if (!el.__revealDone) this._io.observe(el); });\n  }\n\n  componentWillUnmount() {\n    if (this._onScroll) window.removeEventListener('scroll', this._onScroll);\n    if (this._io) this._io.disconnect();\n  }\n\n  renderVals() { return {}; }\n}\n<\u002Fscript>\n\n\n<\u002Fbody><\u002Fhtml>"
  </script>
</body>
</html>